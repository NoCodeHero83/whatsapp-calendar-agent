# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# Token used to verify the webhook URL in Meta Developer Console
META_VERIFY_TOKEN=your_custom_verify_token_here

# Permanent access token from Meta Developer Console > WhatsApp > API Setup
META_ACCESS_TOKEN=your_meta_access_token_here

# Phone Number ID from Meta Developer Console > WhatsApp > API Setup
META_PHONE_NUMBER_ID=your_phone_number_id_here

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Optional: override model (defaults to gpt-4o)
# OPENAI_MODEL=gpt-4o

# ── Google Calendar ───────────────────────────────────────────────────────────
# Calendar ID from Google Calendar settings (share with service account first)
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Full service account JSON as a single-line string (for production/Vercel)
# On local dev, leave this empty and use GOOGLE_SERVICE_ACCOUNT_FILE instead
GOOGLE_SERVICE_ACCOUNT_JSON=

# Path to service account JSON file (local development only)
GOOGLE_SERVICE_ACCOUNT_FILE=whatsapp-calendar-agent-496013-c12f3ed285d4.json

# ── Optional ──────────────────────────────────────────────────────────────────
# Timezone for appointment scheduling (IANA timezone name)
TIMEZONE=America/Lima

# Enable verbose debug logging
# DEBUG=true
